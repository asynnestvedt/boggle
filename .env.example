PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=.data
NODE_ENV=development
# Set this to the exact number of trusted reverse proxies in production.
TRUST_PROXY_HOPS=0

# Without SMTP, development reset emails are saved under .data/outbox/.
# Production requires an HTTPS APP_URL, SMTP_HOST, and MAIL_FROM.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Woggle <woggle@example.com>
# RESET_EMAIL_DISABLED=true
